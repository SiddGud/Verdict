# Copy to .env for local development. On the host, set these as environment variables instead.
QLOO_API_KEY=
# Shows on sale in each city (Ticketmaster Discovery API)
TICKETMASTER_API_KEY=
# Fan overlap for acts Qloo does not hold (Last.fm API)
LASTFM_API_KEY=
# Model host for GPT-6 Astra: comet (CometAPI, pay as you go) or kie
LLM_PROVIDER=comet
COMET_API_KEY=
KIE_API_KEY=
